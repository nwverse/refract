          "padding": { "kind": "chain", "target": "padding", "arguments": [{ "source": "_" }] }
        }
      }
    },
    "nativeComponents": {},
    "modifiers": {
      "padding": { "parameters": [{ "label": "_", "type": "length", "required": true }] }
    },
    "tokens": {
      "spacing": { "DesignSpacing.medium": "AppSpacing.medium" },
      "radius": {},
      "font": {},
      "color": {}
    },
    "resources": {
      "className": "refract.generated.R",
      "catalog": "values/strings.xml",
      "strings": { "settings.online": "settings_online" }
    }
  },
  "harmonyOS": {
