      "padding": { "parameters": [{ "label": "_", "type": "length", "required": true }] }
    },
    "tokens": {
      "spacing": { "DesignSpacing.medium": "AppSpacing.medium" },
      "radius": {},
      "font": {},
      "color": {}
    },
    "resources": {
      "namespace": "app",
      "stringTable": "string",
      "catalog": "resources/base/element/string.json",
      "strings": { "settings.online": "settings_online" }
